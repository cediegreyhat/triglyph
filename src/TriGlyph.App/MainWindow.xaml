<Window x:Class="TriGlyph.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TriGlyph - KF420 DGT panel"
        Width="1020" Height="680" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Bg}"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="12"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="shell" Background="Transparent" CornerRadius="10"
                                Padding="14,11" Margin="0,3">
                            <Grid>
                                <Border x:Name="marker" Width="3" CornerRadius="2"
                                        HorizontalAlignment="Left" Background="Transparent"
                                        Margin="-8,0,0,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="marker" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="shell" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="5"
                            Background="{DynamicResource Accent}" />
                    <TextBlock Text="TriGlyph" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Fg}" />
                    <TextBlock Text="KF420 DGT panel" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource FgMuted}" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                    <Button Style="{StaticResource ChromeButton}" Content="&#x2013;"
                            Click="Minimize_Click" ToolTip="Minimise" />
                    <Button Style="{StaticResource ChromeButton}" Content="&#x2715;"
                            Click="Close_Click" ToolTip="Hide to tray" />
                </StackPanel>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="212" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="14,4,10,16">
                    <TextBlock Style="{StaticResource Eyebrow}" Text="NAVIGATION"
                               Margin="16,8,0,6" />
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}"
                                 Content="Dashboard" Tag="dashboard" IsChecked="True"
                                 Checked="Nav_Checked" />
                    <RadioButton x:Name="NavAdvanced" Style="{StaticResource NavButton}"
                                 Content="Advanced" Tag="advanced" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}"
                                 Content="Settings" Tag="settings" Checked="Nav_Checked" />

                    <Border Style="{StaticResource CardInset}" Margin="4,20,4,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="STATUS" />
                            <TextBlock x:Name="NavStatus" Text="starting" Margin="0,6,0,0"
                                       TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource FgMuted}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Column="1" Margin="0,4,18,18">
                    <ContentControl x:Name="ContentHost" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
