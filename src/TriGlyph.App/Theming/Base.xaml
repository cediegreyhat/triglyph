<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Defaults mirror the "glass" preset. ThemeApplier overwrites these at runtime. -->
    <SolidColorBrush x:Key="Bg" Color="#050505" />
    <SolidColorBrush x:Key="Surface" Color="#101418" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#161B22" />
    <SolidColorBrush x:Key="BorderBrush" Color="#232A33" />
    <SolidColorBrush x:Key="Fg" Color="#F2F5F8" />
    <SolidColorBrush x:Key="FgMuted" Color="#8B97A6" />
    <SolidColorBrush x:Key="Accent" Color="#22D3EE" />
    <SolidColorBrush x:Key="AccentAlt" Color="#34D399" />
    <SolidColorBrush x:Key="AccentSoft" Color="#3322D3EE" />
    <SolidColorBrush x:Key="AccentGlow" Color="#6622D3EE" />
    <SolidColorBrush x:Key="Good" Color="#34D399" />
    <SolidColorBrush x:Key="Warn" Color="#FBBF24" />
    <SolidColorBrush x:Key="Bad" Color="#F87171" />
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

    <!-- Double-bezel card: outer shell holds a hairline ring, inner core carries the
         content. Reads as machined hardware rather than a flat panel. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="CardInset" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="#050505" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="shell" Background="{TemplateBinding Background}"
                            CornerRadius="20" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="shell" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="shell" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="shell" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource Bad}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="Margin" Value="0,6,0,6" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    </Style>

    <Style x:Key="NavTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="shell" Background="Transparent" CornerRadius="10"
                            Padding="16,11" Margin="0,3">
                        <Grid>
                            <Border x:Name="marker" Width="3" CornerRadius="2"
                                    HorizontalAlignment="Left" Background="Transparent"
                                    Margin="-10,0,0,0" />
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="shell" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="shell" Property="Background" Value="{DynamicResource AccentSoft}" />
                            <Setter TargetName="marker" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
