<UserControl x:Class="TriGlyph.App.Views.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,0">

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource Eyebrow}" Text="REPORT DESCRIPTOR" />
                        <Button Content="Re-read" HorizontalAlignment="Right"
                                Style="{StaticResource GhostButton}" Padding="12,5"
                                Click="Reread_Click" />
                    </Grid>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                               Text="The vendor never published this descriptor. Decoding it is how we discover report ids beyond the known temperature report." />
                    <Border Style="{StaticResource CardInset}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="DescriptorSummary" Text="not read yet"
                                       FontSize="12" Foreground="{DynamicResource Fg}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="RawHexText" Text="" Margin="0,10,0,0"
                                       FontFamily="Consolas" FontSize="10"
                                       Foreground="{DynamicResource FgMuted}"
                                       TextWrapping="Wrap" MaxHeight="90" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="DECODED REPORTS"
                               Margin="0,14,0,6" />
                    <ListBox x:Name="ReportList" Height="110" Background="Transparent"
                             BorderThickness="0" Foreground="{DynamicResource Fg}"
                             FontFamily="Consolas" FontSize="11"
                             ItemsSource="{Binding Reports}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="RAW FEATURE REPORT CONSOLE" />

                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                               Text="Send an arbitrary feature report. Report 7 is the known temperature report and is always permitted. Anything else requires arming, because a bad USB state can leave the panel unconfigured until reboot." />

                    <CheckBox x:Name="ArmCheck" Margin="0,12,0,0"
                              Content="Arm unsafe writes (unknown report ids)"
                              Checked="Arm_Changed" Unchecked="Arm_Changed" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Report id" VerticalAlignment="Center"
                                   Margin="0,0,10,0" Foreground="{DynamicResource FgMuted}" />
                        <TextBox x:Name="ReportIdBox" Grid.Column="1" Text="7" />
                    </Grid>

                    <TextBlock Text="Payload (hex, 64 bytes for report 7)" Margin="0,10,0,4"
                               Foreground="{DynamicResource FgMuted}" FontSize="12" />
                    <TextBox x:Name="PayloadBox" FontFamily="Consolas" FontSize="11"
                             Text="07 FF FF 00 2D 00" AcceptsReturn="False" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Send" Style="{StaticResource PrimaryButton}"
                                Click="Send_Click" />
                        <Button Content="Read" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Click="Read_Click" />
                        <Button Content="Fill 64 bytes" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Click="Fill_Click" />
                    </StackPanel>

                    <TextBlock x:Name="ConsoleResult" Style="{StaticResource Muted}"
                               Margin="0,12,0,0" />

                    <TextBlock Style="{StaticResource Eyebrow}" Text="CONSOLE LOG"
                               Margin="0,16,0,6" />
                    <ListBox Height="140" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource FgMuted}" FontFamily="Consolas"
                             FontSize="10" ItemsSource="{Binding Log}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
