<UserControl x:Class="TriGlyph.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,0">

            <!-- Hero readout -->
            <Border Style="{StaticResource Card}" Padding="26,22,26,22" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Eyebrow}" Text="CPU TEMPERATURE" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="Readout" Text="--" FontSize="92" FontWeight="Light"
                                       Foreground="{DynamicResource Fg}" LineHeight="98">
                                <TextBlock.Effect>
                                    <DropShadowEffect x:Name="ReadoutGlow" BlurRadius="46"
                                                      ShadowDepth="0" Opacity="0.9"
                                                      Color="#22D3EE" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock x:Name="UnitText" Text="C" FontSize="26"
                                       VerticalAlignment="Bottom" Margin="10,0,0,20"
                                       Foreground="{DynamicResource FgMuted}" />
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Style="{StaticResource Muted}"
                                   Text="starting up" Margin="2,10,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <Border x:Name="LiveChip" Background="{DynamicResource SurfaceAlt}"
                                CornerRadius="14" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="LiveDot" Width="8" Height="8" CornerRadius="4"
                                        Background="{DynamicResource Bad}" VerticalAlignment="Center" />
                                <TextBlock x:Name="LiveText" Text="STALE" Margin="8,0,0,0"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource FgMuted}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Device + source -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}" Text="PANEL" />
                        <TextBlock x:Name="DeviceText" Text="not detected" Margin="0,8,0,0"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg}" TextWrapping="Wrap" />
                        <TextBlock x:Name="MatchText" Style="{StaticResource Muted}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}" Text="SOURCE" />
                        <TextBlock x:Name="SourceText" Text="-" Margin="0,8,0,0"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                   Text="Priority is configured in Settings. No driver, no admin." />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent activity -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="RECENT ACTIVITY" />
                    <ListBox x:Name="ActivityList" Height="150" Margin="0,10,0,0"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource FgMuted}"
                             ItemsSource="{Binding Log}" FontSize="11" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
